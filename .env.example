# ─────────────────────────────────────────────────────────────
# Roque environment — copy to .env and fill in. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# ── Chain ──────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# ── Deployer / relayer keys (testnet only, treat as burnable) ──
# The account that deploys contracts and pays gas.
DEPLOYER_PRIVATE_KEY=0x...
# The agent signer the relayer uses to authorize intents on behalf of users.
AGENT_SIGNER_PRIVATE_KEY=0x...

# ── Etherscan (optional, for contract verification) ────────────
ETHERSCAN_API_KEY=

# ── Deployed contract addresses (filled by the deploy script) ──
USDC_ADDRESS=
WETH_ADDRESS=
POOL_ADDRESS=
ROUTER_ADDRESS=
ORDERBOOK_ADDRESS=
AGENT_EXECUTOR_ADDRESS=
CHAINLINK_ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306

# ── GenLayer ───────────────────────────────────────────────────
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=

# ── Privy (frontend auth, external wallets only) ───────────────
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Neon Postgres (activity log / indexer) ─────────────────────
DATABASE_URL=

# ── Backend ────────────────────────────────────────────────────
RELAYER_PORT=8787
NEXT_PUBLIC_API_URL=http://localhost:8787
