{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "crons": [
    {
      "path": "/api/cron/keeper",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/judgment",
      "schedule": "40 12 * * *"
    },
    {
      "path": "/api/cron/public",
      "schedule": "5 0 * * *"
    }
  ]
}
